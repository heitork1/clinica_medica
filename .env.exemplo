# Copie este arquivo para .env e preencha com os dados do seu PostgreSQL.
DB_HOST=localhost
DB_PORT=5432
DB_NAME=clinica_medica
DB_USER=postgres
DB_PASSWORD=

# Chave usada pelo Flask para assinar a sessão. Para gerar uma:
#   python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=troque-esta-chave

# Valor sugerido para a consulta na tela de atendimento (pode ser alterado em cada atendimento)
VALOR_CONSULTA_PADRAO=150.00

# 1 = modo de desenvolvimento: recarrega o código ao salvar e libera a página /estilo
FLASK_DEBUG=1
